{
  "name": "social-ai-platform",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered social media & WhatsApp management platform (multi-tenant SaaS)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @platform/database generate",
    "db:migrate": "pnpm --filter @platform/database migrate:dev",
    "db:deploy": "pnpm --filter @platform/database migrate:deploy",
    "db:seed": "pnpm --filter @platform/database seed",
    "worker": "pnpm --filter web worker",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "eslint": "9.39.5",
    "typescript-eslint": "8.70.0",
    "eslint-config-prettier": "10.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "msgpackr-extract"
    ]
  }
}
