# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Copy first, then install: `COPY packages/*/package.json packages/` flattens
# every manifest onto one path, leaving pnpm without the workspace's dev
# dependencies (tsx and the Prisma CLI among them).
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
RUN pnpm --filter @platform/database generate

ENV NODE_ENV=production
RUN groupadd -r app && useradd -r -g app app && chown -R app:app /app
USER app
# Runs migrations, the idempotent seed (plans, AI catalogue, flags), then the BullMQ workers (spec §15).
CMD ["sh", "-c", "pnpm --filter @platform/database migrate:deploy && pnpm --filter @platform/database seed && pnpm --filter web worker"]
