# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
WEBHOOK_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_ai?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/social_ai?schema=public
REDIS_URL=redis://localhost:6379

# 32+ random bytes, base64 or hex. Used to sign sessions and OAuth state.
AUTH_SECRET=
# Exactly 32 bytes encoded as base64 (44 chars) or hex (64 chars). Encrypts OAuth tokens / API keys at rest.
ENCRYPTION_KEY=
# Optional: promoted to Super Admin by `pnpm db:seed` (the worker container seeds on start).
SEED_ADMIN_EMAIL=

# ---- Media (Contabo Object Storage / S3) ----
# Copy the HTTPS S3 endpoint from Contabo's S3 connection settings (no bucket path).
S3_ENDPOINT=
# Contabo's S3 signing region is typically default; set it with the other required fields.
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Leave blank for private media with signed downloads. Optional full public bucket/CDN URL.
S3_PUBLIC_BASE_URL=
# See docs/contabo-storage.md for setup and browser upload CORS.

# ---- Legacy R2 support (unused when S3 is configured) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public base URL for a bucket exposed through a CDN
R2_PUBLIC_BASE_URL=
# Without object storage, web + worker need the same persistent media directory.
MEDIA_LOCAL_DIR=

# ---- Social providers ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional YYYYMM "LinkedIn-Version" header. LinkedIn retires versions after ~1 year; bump this if
# publishing fails with "Requested version ... is not active".
LINKEDIN_API_VERSION=

META_APP_ID=
META_APP_SECRET=
# Verify token you register on the Meta app dashboard for webhook subscriptions
META_WEBHOOK_VERIFY_TOKEN=

# ---- AI providers (platform-level keys; organizations may bring their own) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Meta AI (Muse Spark) over the Responses API. The URL defaults to https://api.meta.ai/v1.
META_AI_API_KEY=
META_AI_BASE_URL=

# ---- Research connectors (platform-level; organizations may bring their own) ----
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ---- Email (invitations). Without a key, messages are logged instead of sent ----
RESEND_API_KEY=
EMAIL_FROM="Social AI Platform <no-reply@yourdomain.com>"

# ---- Serverless worker (Vercel Cron calls /api/internal/drain with this bearer token) ----
CRON_SECRET=

# ---- Limits & plugins ----
# AI calls per organization per minute (0 disables the limit)
AI_RATE_LIMIT_PER_MINUTE=60
# Set to 1 to allow plugins on private/loopback addresses (self-hosted MCP servers on a LAN)
PLUGIN_ALLOW_PRIVATE_URLS=

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=info
