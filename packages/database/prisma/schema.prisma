// =============================================================================
// AI-Powered Social Media & WhatsApp Management Platform — data model
//
// Sections:
//   1. Authentication (managed by better-auth: User, Session, Account, Verification)
//   2. Tenancy (managed by better-auth organization plugin: Organization, Member, Invitation)
//      + platform-owned OrganizationSettings / Plan / FeatureFlag
//   3. Social accounts & credentials
//   4. Media
//   5. Content & publishing pipeline
//   6. AI providers, usage, brand knowledge
//   7. WhatsApp messaging / CRM domain
//   8. Webhooks, audit, analytics
//
// Every tenant-owned table carries organizationId and an index on it. The
// application layer (packages/database/src/tenant.ts) refuses queries on these
// tables that do not include an organizationId filter.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// 1. Authentication (better-auth core + admin plugin fields)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // better-auth admin plugin. role = "admin" marks a platform Super Admin.
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  status        String    @default("ACTIVE")

  sessions        Session[]
  accounts        Account[]
  members         Member[]
  invitations     Invitation[]
  posts           Post[]
  aiUsage         AIUsage[]
  auditLogs       AuditLog[]
  mediaAssets     MediaAsset[]
  assignedConvos  Conversation[] @relation("ConversationAssignee")
  postApprovals   PostApproval[]
  conversationNotes ConversationNote[]

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // admin plugin
  impersonatedBy       String?
  // organization plugin
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

/// better-auth "account" = a login method (credential password or social sign-in).
/// NOT a connected social publishing account — see SocialAccount.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// -----------------------------------------------------------------------------
// 2. Tenancy
// -----------------------------------------------------------------------------

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  metadata  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  // platform-owned additional fields
  status    String    @default("ACTIVE") // ACTIVE | SUSPENDED | ARCHIVED
  planId    String?
  plan      Plan?     @relation(fields: [planId], references: [id])

  members         Member[]
  invitations     Invitation[]
  settings        OrganizationSettings?
  socialAccounts  SocialAccount[]
  mediaAssets     MediaAsset[]
  posts           Post[]
  aiUsage         AIUsage[]
  aiKeys          OrganizationAIKey[]
  aiConnections   OrganizationAIConnection[]
  connectors      OrganizationConnector[]
  skills          OrganizationSkill[]
  plugins         OrganizationPlugin[]
  researchBriefs  ResearchBrief[]
  brands          Brand[]
  contacts        Contact[]
  conversations   Conversation[]
  whatsappAccounts WhatsAppAccount[]
  whatsappTemplates WhatsAppTemplate[]
  campaigns       Campaign[]
  automations     Automation[]
  auditLogs       AuditLog[]
  webhookEvents   WebhookEvent[]
  oauthStates     OAuthState[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@index([status])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MANAGER | EDITOR | APPROVER | MEMBER | VIEWER
  createdAt      DateTime     @default(now())
  status         String       @default("ACTIVE") // ACTIVE | SUSPENDED

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String
  status         String       @default("pending")
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model OrganizationSettings {
  id                          String       @id @default(cuid())
  organizationId              String       @unique
  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timezone                    String       @default("UTC")
  requireApproval             Boolean      @default(true)
  /// Role -> enabled CONFIGURED capabilities (see @platform/rbac OrgPermissionOverrides)
  permissionOverrides         Json?
  aiDefaultProvider           String? // OPENAI | ANTHROPIC | GOOGLE
  aiDefaultModel              String?
  aiImageProvider             String?
  aiImageModel                String?
  aiRetainPrompts             Boolean      @default(true)
  whatsappRequireHumanApproval Boolean     @default(true)
  updatedAt                   DateTime     @updatedAt
}

model Plan {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String?
  priceCents    Int            @default(0)
  currency      String         @default("USD")
  /// { socialAccounts, members, postsPerMonth, aiTokensPerMonth, aiImagesPerMonth, whatsappNumbers }
  limits        Json
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
}

model FeatureFlag {
  key            String   @id
  description    String?
  enabled        Boolean  @default(false)
  /// Optional allow-list of organization ids while rolling out
  organizationIds String[] @default([])
  updatedAt      DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 3. Social accounts & credentials
// -----------------------------------------------------------------------------

enum Platform {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  X
  TIKTOK
  YOUTUBE
  THREADS
  PINTEREST
}

enum SocialAccountType {
  PROFILE
  PAGE
  ORGANIZATION
  CHANNEL
  BUSINESS
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  DISCONNECTED
  ERROR
}

model SocialAccount {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform          Platform
  accountType       SocialAccountType
  externalAccountId String
  username          String?
  displayName       String
  avatarUrl         String?
  profileUrl        String?
  status            SocialAccountStatus @default(CONNECTED)
  /// Provider-specific capability snapshot synced at connect time
  capabilities      Json?
  /// Provider-specific, non-secret metadata (page category, org URN...)
  metadata          Json?
  requireApproval   Boolean?            // null = inherit organization setting
  connectedById     String?
  lastSyncedAt      DateTime?
  lastError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  credential    SocialCredential?
  postVariants  PostVariant[]
  snapshots     AnalyticsSnapshot[]

  @@unique([organizationId, platform, externalAccountId])
  @@index([organizationId, status])
}

model SocialCredential {
  id                    String        @id @default(cuid())
  socialAccountId       String        @unique
  socialAccount         SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  refreshExpiresAt      DateTime?
  scopes                String[]      @default([])
  /// Encrypted JSON for provider secrets that don't fit the token fields
  metadataEncrypted     String?
  keyId                 String        @default("k1")
  rotatedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

/// Short-lived OAuth state for CSRF protection + PKCE verifier storage.
model OAuthState {
  id             String       @id @default(cuid())
  state          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  provider       String // LINKEDIN | META | X | TIKTOK | GOOGLE
  codeVerifier   String?
  redirectTo     String?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// 4. Media
// -----------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  GIF
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model MediaAsset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  kind           MediaKind
  storageKey     String       @unique
  fileName       String
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  duration       Float?
  checksum       String?
  status         MediaStatus  @default(PENDING_UPLOAD)
  altText        String?
  /// Platform-specific derived renditions: { thumbnail: key, instagram_square: key, ... }
  variants       Json?
  source         String       @default("UPLOAD") // UPLOAD | AI_GENERATED
  aiPrompt       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  postMedia PostMedia[]

  @@unique([organizationId, checksum])
  @@index([organizationId, kind])
}

// -----------------------------------------------------------------------------
// 5. Content & publishing
// -----------------------------------------------------------------------------

enum PostStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  RETRYING
  CANCELLED
  DISCONNECTED_ACCOUNT
  DELETED
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model Post {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])
  title          String?
  masterText     String
  status         PostStatus     @default(DRAFT)
  approvalStatus ApprovalStatus @default(NOT_REQUIRED)
  scheduledAt    DateTime?
  timezone       String         @default("UTC")
  /// When true, approving the post schedules it automatically (at scheduledAt, or immediately).
  autoPublishOnApproval Boolean @default(false)
  publishedAt    DateTime?
  /// Free-form labels for calendar filtering
  tags           String[]       @default([])
  /// Source idea / AI generation trace id
  sourceRef      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  variants  PostVariant[]
  approvals PostApproval[]

  @@index([organizationId, status])
  @@index([organizationId, scheduledAt])
}

model PostVariant {
  id              String        @id @default(cuid())
  postId          String
  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform        Platform
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  text            String
  status          PostStatus    @default(DRAFT)
  /// Platform-specific options: { firstComment, linkUrl, altTexts, title, privacy, ... }
  platformOptions Json?
  externalPostId  String?
  externalUrl     String?
  lastError       String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  media       PostMedia[]
  publishJobs PublishJob[]
  snapshots   AnalyticsSnapshot[]

  @@unique([postId, socialAccountId])
  @@index([socialAccountId, status])
}

model PostMedia {
  id            String      @id @default(cuid())
  postVariantId String
  postVariant   PostVariant @relation(fields: [postVariantId], references: [id], onDelete: Cascade)
  mediaAssetId  String
  mediaAsset    MediaAsset  @relation(fields: [mediaAssetId], references: [id])
  sortOrder     Int         @default(0)

  @@unique([postVariantId, mediaAssetId])
}

model PostApproval {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  decision   String // APPROVED | REJECTED | COMMENT
  comment    String?
  createdAt  DateTime @default(now())

  @@index([postId])
}

enum PublishJobStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model PublishJob {
  id             String           @id @default(cuid())
  postVariantId  String
  postVariant    PostVariant      @relation(fields: [postVariantId], references: [id], onDelete: Cascade)
  /// Idempotency key: one active job per variant+scheduledAt; also used as the BullMQ job id
  idempotencyKey String           @unique
  scheduledAt    DateTime
  status         PublishJobStatus @default(PENDING)
  attemptCount   Int              @default(0)
  maxAttempts    Int              @default(5)
  nextAttemptAt  DateTime?
  lastError      String?
  queueJobId     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attempts PublishAttempt[]

  @@index([status, scheduledAt])
  @@index([postVariantId])
}

model PublishAttempt {
  id             String     @id @default(cuid())
  publishJobId   String
  publishJob     PublishJob @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
  attemptNumber  Int
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  status         String // RUNNING | SUCCEEDED | FAILED
  externalPostId String?
  error          String?
  errorCode      String?
  retryable      Boolean?
  durationMs     Int?

  @@index([publishJobId])
}

// -----------------------------------------------------------------------------
// 6. AI
// -----------------------------------------------------------------------------

enum AIProviderName {
  OPENAI
  ANTHROPIC
  GOOGLE
}

/// Platform-level model catalogue managed by Super Admin.
model AIProviderConfig {
  id            String         @id @default(cuid())
  provider      AIProviderName
  model         String
  displayName   String
  active        Boolean        @default(true)
  capabilities  String[]       @default([]) // text | image | vision | embedding | json
  /// USD per 1M tokens (or per image) used for cost estimation
  inputCostPerM Float          @default(0)
  outputCostPerM Float         @default(0)
  imageCost     Float          @default(0)
  isDefault     Boolean        @default(false)
  priority      Int            @default(100)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([provider, model])
}

/// Bring-your-own-key: organization-supplied provider keys, encrypted at rest.
model OrganizationAIKey {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       AIProviderName
  keyEncrypted   String
  label          String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, provider])
}

/// Custom AI connection: any proxy, endpoint, or provider the org wants to use.
model OrganizationAIConnection {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String   // user-facing label, e.g. "My OpenAI Proxy"
  provider       String   // "OPENAI" | "ANTHROPIC" | "GOOGLE" | "CUSTOM"
  baseUrl        String   // API base URL, e.g. https://claude.opuscode.pro/api
  apiKeyEncrypted String
  models         String?  // JSON array of model IDs this connection supports
  isActive       Boolean  @default(true)
  lastTestedAt   DateTime?
  lastTestStatus String?  // "ok" | "error"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model AIUsage {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider       AIProviderName
  model          String
  operation      String
  inputTokens    Int            @default(0)
  outputTokens   Int            @default(0)
  imageCount     Int            @default(0)
  estimatedCost  Float          @default(0)
  latencyMs      Int?
  success        Boolean        @default(true)
  errorCode      String?
  /// Retained only when OrganizationSettings.aiRetainPrompts is true
  promptSnapshot String?
  createdAt      DateTime       @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, provider])
}

/// Research connector keys an organization brings (Tavily, Brave...), encrypted at rest.
model OrganizationConnector {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector      String // TAVILY | BRAVE
  keyEncrypted   String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, connector])
}

/// Output of a research skill run: a sourced brief that can seed posts.
/// Imported or hand-written Agent-Skills playbooks the model follows (SKILL.md + references).
model OrganizationSkill {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  description    String       @default("")
  instructions   String
  sourceUrl      String?
  enabled        Boolean      @default(true)
  /// Injected into every AI call for this organization (generate, rewrite, hashtags, calendar), not just research runs.
  autoApply      Boolean      @default(false)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, enabled])
}

enum PluginKind {
  MCP
  HTTP
}

/// External tools the model may call: an MCP server (streamable HTTP) or a single HTTP endpoint.
model OrganizationPlugin {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug             String
  name             String
  description      String       @default("")
  kind             PluginKind
  url              String
  /// Encrypted JSON of extra request headers (Authorization etc.)
  headersEncrypted String?
  /// HTTP plugins: JSON schema for the tool arguments and the HTTP method to use
  inputSchema      Json?
  method           String       @default("POST")
  enabled          Boolean      @default(true)
  lastTestedAt     DateTime?
  lastTestStatus   String?
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, enabled])
}

model ResearchBrief {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  skill          String
  input          String
  platforms      String[]     @default([])
  title          String
  summary        String
  /// Full structured brief (key points, angles, post ideas, sources, caveats)
  brief          Json
  /// Tool calls made during the run
  trace          Json?
  provider       String?
  model          String?
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model Brand {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  industry       String?
  audience       String?
  tone           String?
  language       String       @default("en")
  /// Do / don't rules, banned phrases, hashtag policy ...
  rules          Json?
  voiceExamples  String[]     @default([])
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  knowledge BrandKnowledge[]

  @@index([organizationId])
}

model BrandKnowledge {
  id           String   @id @default(cuid())
  brandId      String
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sourceType   String // DOCUMENT | URL | POST | NOTE
  sourceKey    String
  title        String?
  content      String
  chunkIndex   Int      @default(0)
  /// Reference into the vector store (pgvector row id or external index id)
  embeddingRef String?
  createdAt    DateTime @default(now())

  @@index([brandId])
}

// -----------------------------------------------------------------------------
// 7. WhatsApp messaging / CRM
// -----------------------------------------------------------------------------

model WhatsAppAccount {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wabaId              String
  phoneNumberId       String
  displayPhoneNumber  String
  verifiedName        String?
  qualityRating       String?
  status              String       @default("CONNECTED") // CONNECTED | DISCONNECTED | ERROR
  accessTokenEncrypted String
  /// App-specific secret used to verify webhook signatures when different from platform app
  metadata            Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  conversations Conversation[]
  templates     WhatsAppTemplate[]
  campaigns     Campaign[]

  @@unique([organizationId, phoneNumberId])
  @@index([phoneNumberId])
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phone          String // E.164
  name           String?
  email          String?
  tags           String[]     @default([])
  metadata       Json?
  optedOut       Boolean      @default(false)
  lastSeenAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversations Conversation[]

  @@unique([organizationId, phone])
  @@index([organizationId, name])
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
}

model Conversation {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel                String             @default("WHATSAPP")
  whatsappAccountId      String?
  whatsappAccount        WhatsAppAccount?   @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  externalConversationId String?
  contactId              String
  contact                Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status                 ConversationStatus @default(OPEN)
  assigneeId             String?
  assignee               User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  unreadCount            Int                @default(0)
  lastMessageAt          DateTime?
  lastMessagePreview     String?
  /// 24h customer service window end, derived from last inbound message
  serviceWindowEndsAt    DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  messages Message[]
  notes    ConversationNote[]

  @@unique([organizationId, whatsappAccountId, contactId])
  @@index([organizationId, status, lastMessageAt])
  @@index([assigneeId])
}

model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection
  externalMessageId String?          @unique
  type              String // TEXT | IMAGE | VIDEO | AUDIO | DOCUMENT | TEMPLATE | INTERACTIVE | ...
  /// Normalised content: { text, mediaId, mediaUrl, caption, templateName, components, ... }
  content           Json
  status            MessageStatus    @default(PENDING)
  errorCode         String?
  errorMessage      String?
  sentById          String?
  aiSuggested       Boolean          @default(false)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model WhatsAppTemplate {
  id                 String          @id @default(cuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappAccountId  String
  whatsappAccount    WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  externalTemplateId String
  name               String
  language           String
  category           String? // MARKETING | UTILITY | AUTHENTICATION
  status             String // PENDING | APPROVED | REJECTED | PAUSED | DISABLED
  components         Json
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([whatsappAccountId, externalTemplateId])
  @@index([organizationId, status])
}

model Campaign {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappAccountId String
  whatsappAccount   WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  name              String
  templateName      String
  templateLanguage  String
  /// { tags: [...], contactIds: [...], excludeOptedOut: true }
  audience          Json
  /// Template parameter mapping
  parameters        Json?
  status            String          @default("DRAFT") // DRAFT | SCHEDULED | RUNNING | COMPLETED | CANCELLED | FAILED
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  totalRecipients   Int             @default(0)
  sentCount         Int             @default(0)
  deliveredCount    Int             @default(0)
  readCount         Int             @default(0)
  failedCount       Int             @default(0)
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([organizationId, status])
}

model Automation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// { type: "INBOUND_MESSAGE" | "KEYWORD" | "NEW_CONVERSATION" | "SCHEDULE", ... }
  trigger        Json
  /// [{ field, op, value }]
  conditions     Json?
  /// [{ type: "SEND_TEXT" | "SEND_TEMPLATE" | "ASSIGN" | "TAG" | "AI_REPLY", ... }]
  actions        Json
  status         String       @default("ACTIVE") // ACTIVE | PAUSED
  runCount       Int          @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

// -----------------------------------------------------------------------------
// 8. Webhooks, audit, analytics
// -----------------------------------------------------------------------------

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model WebhookEvent {
  id              String             @id @default(cuid())
  provider        String // META | WHATSAPP | LINKEDIN | TIKTOK | X | GOOGLE
  /// Provider event id or a hash of the payload; enforces idempotency.
  externalEventId String
  eventType       String
  organizationId  String?
  organization    Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  attempts        Int                @default(0)
  error           String?
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@index([organizationId])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Set when a Super Admin acts on behalf of a user via impersonation
  impersonatorId String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([resourceType, resourceId])
}

model AnalyticsSnapshot {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  postVariantId   String?
  postVariant     PostVariant?  @relation(fields: [postVariantId], references: [id], onDelete: Cascade)
  scope           String // ACCOUNT | POST
  capturedAt      DateTime      @default(now())
  /// Normalised subset: { impressions, reach, likes, comments, shares, clicks, followers }
  metrics         Json
  /// Raw provider-specific metrics
  raw             Json?

  @@index([organizationId, scope, capturedAt])
  @@index([socialAccountId, capturedAt])
  @@index([postVariantId, capturedAt])
}
